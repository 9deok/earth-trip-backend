DATABASE_URL=jdbc:mariadb://127.0.0.1:3306/earth_trip
DATABASE_USERNAME=earth_trip_app
DATABASE_PASSWORD=replace-with-a-long-random-password
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8050
LOG_PATH=logs
HTTP_LOG_MAX_PAYLOAD_BYTES=8192
HTTP_LOG_SUCCESS_DETAILS_ENABLED=false
OUTBOUND_HTTP_CONNECT_TIMEOUT=5s
OUTBOUND_HTTP_READ_TIMEOUT=15s
PUBLIC_BASE_URL=https://earth-trips.com
BACKEND_PUBLIC_BASE_URL=https://api.earth-trips.com
REALTIME_ALLOWED_ORIGINS=https://earth-trips.com

GOOGLE_OAUTH_CLIENT_IDS=replace-with-google-web-client-id.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_IDS=com.example.earthtrip
GOOGLE_MAPS_SERVER_API_KEY=replace-with-restricted-server-key

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=replace-with-least-privilege-iam-access-key
AWS_SECRET_ACCESS_KEY=replace-with-rotated-iam-secret-key
SES_FROM_EMAIL=no-reply@earth-trips.com
SES_CONFIGURATION_SET=earth-trip-transactional

FIREBASE_PROJECT_ID=replace-with-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/etc/earth-trip/firebase-service-account.json
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=replace-with-calendar-client-id
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=replace-with-calendar-client-secret
GOOGLE_CALENDAR_OAUTH_CALLBACK_URI=replace-with-exact-google-registered-redirect-uri

MOFA_OPENAPI_SERVICE_KEY=replace-with-public-data-service-key
AMADEUS_API_BASE_URL=https://test.api.amadeus.com
AMADEUS_API_KEY=replace-with-amadeus-key
AMADEUS_API_SECRET=replace-with-amadeus-secret

OBJECT_STORAGE_LOCAL_ROOT=/var/lib/earth-trip/objects
OBJECT_STORAGE_SIGNING_KEY_BASE64=replace-with-base64-32-byte-key
PERSONAL_DATA_EXPORT_ROOT=/var/lib/earth-trip/exports
CLAMAV_ENDPOINT=unix:/run/clamd.scan/clamd.sock
WALLET_DATA_ENCRYPTION_KEYS=primary:replace-with-base64-32-byte-key
WALLET_DATA_PRIMARY_KEY_ID=primary
PUSH_TOKEN_ENCRYPTION_KEY_BASE64=replace-with-base64-32-byte-key
INTEGRATION_TOKEN_ENCRYPTION_KEYS=primary:replace-with-base64-32-byte-key
INTEGRATION_TOKEN_PRIMARY_KEY_ID=primary

INTERNAL_ADMIN_TOKEN=replace-with-a-long-random-token
INTERNAL_WEBHOOK_MAX_AGE_SECONDS=300
OBJECT_STORAGE_WEBHOOK_SECRET=replace-with-random-secret
MALWARE_SCAN_WEBHOOK_SECRET=replace-with-random-secret
CALENDAR_WEBHOOK_SECRET=replace-with-random-secret
PUSH_DELIVERY_WEBHOOK_SECRET=replace-with-random-secret
FINANCIAL_PROVIDER_WEBHOOK_SECRET=replace-with-random-secret

MINIMUM_ANDROID_BUILD=1
MINIMUM_IOS_BUILD=1
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=
READ_ONLY_AVAILABLE=true
