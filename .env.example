DATABASE_URL=jdbc:mariadb://localhost:3306/earth_trip
DATABASE_USERNAME=earth_trip
DATABASE_PASSWORD=earth_trip_local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
LOG_PATH=logs
HTTP_LOG_MAX_PAYLOAD_BYTES=8192
# 요청/응답 본문은 토큰·비밀번호를 마스킹하고 바이너리는 메타데이터만 기록합니다.
# 개인정보 최소화가 더 중요한 운영 환경에서는 false로 바꿔 성공 응답을 요약만 남길 수 있습니다.
HTTP_LOG_SUCCESS_DETAILS_ENABLED=true
OUTBOUND_HTTP_CONNECT_TIMEOUT=5s
OUTBOUND_HTTP_READ_TIMEOUT=15s
PUBLIC_BASE_URL=http://localhost:3000
BACKEND_PUBLIC_BASE_URL=http://localhost:8080

# Google 로그인 ID 토큰의 aud로 허용할 OAuth 2.0 웹 클라이언트 ID.
# 여러 환경의 웹 클라이언트를 허용해야 할 때만 쉼표로 구분합니다. 클라이언트 보안 비밀번호는 필요하지 않습니다.
GOOGLE_OAUTH_CLIENT_IDS=

# Apple ID 토큰의 aud로 허용할 iOS bundle ID 및 Services ID. 여러 값은 쉼표로 구분합니다.
APPLE_OAUTH_CLIENT_IDS=

# 쉼표로 구분한 브라우저 WebSocket 허용 Origin. 네이티브 앱은 보통 Origin이 없습니다.
REALTIME_ALLOWED_ORIGINS=http://localhost:3000

# /internal/admin/** 및 /actuator/prometheus 전용 토큰
INTERNAL_ADMIN_TOKEN=replace-with-a-long-random-token
INTERNAL_WEBHOOK_MAX_AGE_SECONDS=300

# 제공자별 HMAC-SHA256 웹훅 서명 키
OBJECT_STORAGE_WEBHOOK_SECRET=
MALWARE_SCAN_WEBHOOK_SECRET=
CALENDAR_WEBHOOK_SECRET=
PUSH_DELIVERY_WEBHOOK_SECRET=
FINANCIAL_PROVIDER_WEBHOOK_SECRET=

# Google Maps Platform 서버 API 키. Places, Routes, Weather, Geocoding, Time Zone에서 함께 사용합니다.
GOOGLE_MAPS_SERVER_API_KEY=

# AWS SES transactional email. SDK는 표준 AWS credential provider chain을 사용합니다.
# 로컬/OCI에서는 최소 권한 IAM key, AWS compute에서는 workload role을 사용합니다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@example.com
SES_CONFIGURATION_SET=

# FCM HTTP v1. 서버에는 이 값과 함께 Google Application Default Credentials가 필요합니다.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/etc/earth-trip/firebase-service-account.json

# Google Calendar authorization-code 교환. callback URI는 Google Cloud 등록값과 정확히 같아야 합니다.
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_CALLBACK_URI=

# 외부 여행정보: 외교부 공공데이터 및 Amadeus Self-Service
MOFA_OPENAPI_SERVICE_KEY=
AMADEUS_API_BASE_URL=https://test.api.amadeus.com
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# 서버 로컬 파일 저장소, HMAC 서명 URL, ClamAV
OBJECT_STORAGE_LOCAL_ROOT=/var/lib/earth-trip/objects
OBJECT_STORAGE_SIGNING_KEY_BASE64=
CLAMAV_ENDPOINT=unix:/run/clamd.scan/clamd.sock

# 개인정보 내보내기 결과 저장 경로
PERSONAL_DATA_EXPORT_ROOT=/var/lib/earth-trip/exports

# 민감 예약정보 AES-256-GCM key ring. rotation 시 이전 key도 쉼표로 함께 유지합니다.
# 예: primary:<base64-32-byte-key>,previous:<base64-32-byte-key>
WALLET_DATA_ENCRYPTION_KEYS=
WALLET_DATA_PRIMARY_KEY_ID=primary

# APNs/FCM token AES-256-GCM 32-byte key의 Base64 값
PUSH_TOKEN_ENCRYPTION_KEY_BASE64=

# 외부 계정 refresh token AES-256-GCM key ring
# 예: primary:<base64-32-byte-key>,previous:<base64-32-byte-key>
INTEGRATION_TOKEN_ENCRYPTION_KEYS=
INTEGRATION_TOKEN_PRIMARY_KEY_ID=primary
